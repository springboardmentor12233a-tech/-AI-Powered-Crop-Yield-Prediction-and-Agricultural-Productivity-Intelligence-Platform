# Copy to .env locally. Never commit real credentials.
YIELDSENSE_DB_HOST=localhost
YIELDSENSE_DB_NAME=yieldsense
YIELDSENSE_DB_USER=postgres
YIELDSENSE_DB_PASSWORD=replace-with-a-local-password
YIELDSENSE_DB_PORT=5432
YIELDSENSE_JWT_SECRET=generate-a-random-secret-with-at-least-32-bytes
YIELDSENSE_JWT_ALGORITHM=HS256
YIELDSENSE_JWT_EXPIRE_MINUTES=480
YIELDSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yieldsenseai.vercel.app
GROQ_API_KEY=
GROQ_MODEL=
