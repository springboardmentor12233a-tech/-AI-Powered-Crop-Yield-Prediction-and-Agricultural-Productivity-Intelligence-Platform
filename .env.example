# YieldSense AI Environment Variables
# Copy this file to .env and fill in with actual values
# DO NOT commit .env to Git

# PostgreSQL Credentials (used by docker-compose to init DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=YieldSenseAI

# Database Connection (Backend)
# In Docker, the host is 'db'. For local development without Docker, use 'localhost'.
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@db:5432/YieldSenseAI

# Authentication
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (Comma separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend/Backend URLs (Used for build-args and communication)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# SMTP Configuration for Email
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@yieldsense.ai
