# ==============================================================================
# CropCast - Environment Variables Configuration Template
# Copy this file to .env and configure values before starting the application
# ==============================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=production

# Database Configuration
# Provide your MongoDB Atlas or local MongoDB connection URI:
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
DATABASE_NAME=CropCast

# Optional: PostgreSQL Connection (if using relational storage engine)
# POSTGRES_URL=postgresql://user:password@localhost:5432/cropcast

# Security & JWT Configuration
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Optional: External OpenWeatherMap API Key for hyper-local climate intelligence
OPENWEATHER_API_KEY=
