# Runtime mode: use production on a hosted backend.
YIELDSENSE_ENV=development

# Required when YIELDSENSE_ENV=production.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated browser origins. Keep localhost entries for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional host-provided port; Render and similar platforms set this automatically.
PORT=8000

# Frontend build-time variable (configure in frontend/.env.local or the host dashboard).
# VITE_API_BASE_URL=http://127.0.0.1:8000
