# YieldSense AI Backend Environment Variables
# Copy this file to .env and fill in with actual values
# DO NOT commit .env to Git

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://username:password@host:port/database
# IMPORTANT: URL-encode special characters in password (e.g., @ becomes %40)
DATABASE_URL=postgresql+psycopg2://postgres:<YOUR_PASSWORD>@localhost:5432/YieldSenseAI

# JWT Configuration for Authentication
# Generate a secure random string for JWT_SECRET_KEY (e.g., using: python -c "import secrets; print(secrets.token_urlsafe(32))")
# DO NOT use the default value in production
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
