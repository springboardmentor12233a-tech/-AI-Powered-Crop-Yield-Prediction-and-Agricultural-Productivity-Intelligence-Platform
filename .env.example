# YieldSense AI — Environment Variables Template
# Copy this file to .env and fill in the real values.
# NEVER commit the .env file to Git.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here-minimum-32-characters

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — single file, no extra service needed)
DATABASE_URL=sqlite:///./data/yieldsense.db

# PostgreSQL (for cloud deployment — uncomment and fill in)
# DATABASE_URL=postgresql://user:password@host:5432/yieldsense_db

# ── Machine Learning ──────────────────────────────────────────────────────────
DATASET_PATH=../data/crop_yield.csv
MODEL_DIR=./saved_models

# ── Groq AI API ───────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com
# Leave empty to run without AI features (graceful fallback is implemented)
GROQ_API_KEY=your_groq_api_key_here

# ── Frontend (used at Vite build time, not at runtime) ────────────────────────
# For local development:
VITE_API_URL=http://localhost:8000
# For Docker deployment:
# VITE_API_URL=http://localhost:8000
# For cloud deployment (replace with your actual backend URL):
# VITE_API_URL=https://your-backend-domain.com
